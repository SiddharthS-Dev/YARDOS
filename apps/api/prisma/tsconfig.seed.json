{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "rootDir": "..",
    "types": ["node"],
    "noUnusedLocals": false
  },
  "include": ["**/*.ts", "../src/**/*.ts"],
  "exclude": ["../src/**/*.spec.ts", "../node_modules", "../dist"]
}
