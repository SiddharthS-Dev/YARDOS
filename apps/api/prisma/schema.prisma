model Financier {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @db.Uuid
  code               String   @db.VarChar(32)
  legalName          String   @db.VarChar(256)
  displayName        String   @db.VarChar(128)
  gstin              String?  @db.VarChar(20)
  pan                String?  @db.VarChar(16)
  addressLine1       String?  @db.VarChar(256)
  addressLine2       String?  @db.VarChar(256)
  city               String?  @db.VarChar(128)
  state              String?  @db.VarChar(128)
  postalCode         String?  @db.VarChar(16)
  billingEmail       String?  @db.VarChar(256)
  billingPhone       String?  @db.VarChar(32)
  /// Additional destinations for invoice and alert delivery.
  notificationEmails String[]
  notificationPhones String[]
  /// Default payment terms in days; a contract version may override.
  paymentTermsDays   Int      @default(30)
  isActive           Boolean  @default(true)
  notes              String?  @db.Text
  version            Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)
  createdById        String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  aliases          FinancierAlias[]
  contacts         FinancierContact[]
  users            User[]
  contracts        Contract[]
  vehicles         Vehicle[]
  ownershipRecords VehicleOwnershipRecord[]
  financierHistory VehicleFinancierHistory[]
  sessions         ParkingSession[]
  invoices         Invoice[]
  billingRules     BillingRule[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("financiers")
}

/// Names a financier appears under in registry data.
///
/// VAHAN returns the hypothecation holder as free text, and the same lender
/// appears as "HDFC BANK LTD", "HDFC Bank Limited", "H D F C BANK" and so on.
/// Matching is done on `normalizedAlias` (uppercased, alphanumeric only).
model FinancierAlias {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financierId     String   @db.Uuid
  alias           String   @db.VarChar(256)
  normalizedAlias String   @db.VarChar(256)
  source          String   @default("MANUAL") @db.VarChar(32)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  createdById     String?  @db.Uuid

  financier Financier @relation(fields: [financierId], references: [id], onDelete: Cascade)

  @@unique([financierId, normalizedAlias])
  @@index([normalizedAlias])
  @@map("financier_aliases")
}

model FinancierContact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financierId String   @db.Uuid
  name        String   @db.VarChar(160)
  designation String?  @db.VarChar(128)
  email       String?  @db.VarChar(256)
  phone       String?  @db.VarChar(32)
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  financier Financier @relation(fields: [financierId], references: [id], onDelete: Cascade)

  @@index([financierId, isActive])
  @@map("financier_contacts")
}

// ===========================================================================
// VEHICLE (central repository)
// ===========================================================================

/// The canonical vehicle record.
///
/// Exactly one row per registration number per organisation. Every ANPR capture
/// at every Sri JP location - yard or public car park - resolves to this row,
/// which is what makes the financier-intelligence service possible.
model Vehicle {
  id                          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId              String                  @db.Uuid
  /// As captured / as printed, for display.
  registrationNumber          String                  @db.VarChar(32)
  /// Uppercase alphanumeric. The unique key and the search key.
  normalizedRegistrationNumber String                 @db.VarChar(16)
  registrationFormat          String                  @default("UNRECOGNISED") @db.VarChar(24)
  vehicleClass                VehicleClass            @default(UNKNOWN)
  /// Free-text body type from the registry, when supplied.
  vehicleType                 String?                 @db.VarChar(64)
  make                        String?                 @db.VarChar(96)
  model                       String?                 @db.VarChar(96)
  variant                     String?                 @db.VarChar(96)
  color                       String?                 @db.VarChar(48)
  fuelType                    FuelType?
  manufacturingYear           Int?
  /// Only the last four characters are retained - full chassis/engine numbers
  /// are not required by any workflow here and are needless PII exposure.
  chassisNumberLast4          String?                 @db.VarChar(8)
  engineNumberLast4           String?                 @db.VarChar(8)
  registeredOwnerName         String?                 @db.VarChar(256)
  registeredOwnerAddress      String?                 @db.VarChar(512)
  hypothecationStatus         HypothecationStatus     @default(UNKNOWN)
  vahanVerificationStatus     VahanVerificationStatus @default(NOT_REQUESTED)
  vahanVerifiedAt             DateTime?               @db.Timestamptz(6)
  currentFinancierId          String?                 @db.Uuid
  financierMatchMethod        FinancierMatchMethod    @default(UNMATCHED)
  /// 0.0000 - 1.0000. Below the configured threshold the match needs review.
  financierMatchConfidence    Decimal?                @db.Decimal(5, 4)
  status                      VehicleStatus           @default(CAPTURED)
  currentSiteId               String?                 @db.Uuid
  currentSessionId            String?                 @db.Uuid
  firstSeenAt                 DateTime                @default(now()) @db.Timestamptz(6)
  lastSeenAt                  DateTime                @default(now()) @db.Timestamptz(6)
  /// Denormalised counter, maintained transactionally. Powers "seen N times".
  totalVisits                 Int                     @default(0)
  notes                       String?                 @db.Text
  version                     Int                     @default(0)
  createdAt                   DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                @updatedAt @db.Timestamptz(6)

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  currentFinancier Financier?   @relation(fields: [currentFinancierId], references: [id], onDelete: SetNull)
  currentSite      Site?        @relation("VehicleCurrentSite", fields: [currentSiteId], references: [id], onDelete: SetNull)

  ownershipRecords VehicleOwnershipRecord[]
  financierHistory VehicleFinancierHistory[]
  anprEvents       AnprEvent[]
  registryLookups  VehicleRegistryLookup[]
  sessions         ParkingSession[]
  timelineEvents   VehicleTimelineEvent[]
  invoices         Invoice[]
  releaseRequests  ReleaseRequest[]
  auctionLots      AuctionLot[]

  @@unique([organizationId, normalizedRegistrationNumber])
  @@index([organizationId, status])
  @@index([currentFinancierId, status])
  @@index([currentSiteId, status])
  @@index([normalizedRegistrationNumber])
  @@index([lastSeenAt])
  @@map("vehicles")
}

/// Immutable snapshot of what the vehicle registry said at a point in time.
/// Never updated - a new lookup writes a new row and flips `isCurrent`.
model VehicleOwnershipRecord {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId              String              @db.Uuid
  /// Which provider supplied this, e.g. "mock", "aggregator:<name>".
  provider               String              @db.VarChar(64)
  /// VAHAN | AGGREGATOR | MANUAL | FINANCIER_DECLARED
  source                 String              @db.VarChar(32)
  registeredOwnerName    String?             @db.VarChar(256)
  registeredOwnerAddress String?             @db.VarChar(512)
  /// Hypothecation holder exactly as the registry returned it.
  financierNameRaw       String?             @db.VarChar(256)
  matchedFinancierId     String?             @db.Uuid
  hypothecationStatus    HypothecationStatus @default(UNKNOWN)
  vehicleClass           VehicleClass?
  vehicleType            String?             @db.VarChar(64)
  make                   String?             @db.VarChar(96)
  model                  String?             @db.VarChar(96)
  variant                String?             @db.VarChar(96)
  color                  String?             @db.VarChar(48)
  fuelType               FuelType?
  manufacturingYear      Int?
  registrationDate       DateTime?           @db.Date
  fitnessValidUpto       DateTime?           @db.Date
  insuranceValidUpto     DateTime?           @db.Date
  /// Provider payload with PII fields already reduced. Retained for dispute
  /// resolution; access requires `registry:read`.
  rawResponse            Json?
  retrievedAt            DateTime            @db.Timestamptz(6)
  isCurrent              Boolean             @default(true)
  createdAt              DateTime            @default(now()) @db.Timestamptz(6)

  vehicle           Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  matchedFinancier  Financier?              @relation(fields: [matchedFinancierId], references: [id], onDelete: SetNull)
  lookups           VehicleRegistryLookup[]
  financierHistory  VehicleFinancierHistory[]

  @@index([vehicleId, isCurrent])
  @@index([vehicleId, retrievedAt])
  @@index([matchedFinancierId])
  @@map("vehicle_ownership_records")
}

/// Append-only record of which financier a vehicle belonged to, and when.
/// Supports "this vehicle moved from lender A to lender B" questions.
model VehicleFinancierHistory {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId           String               @db.Uuid
  financierId         String?              @db.Uuid
  financierNameRaw    String?              @db.VarChar(256)
  matchMethod         FinancierMatchMethod
  confidence          Decimal?             @db.Decimal(5, 4)
  effectiveFrom       DateTime             @db.Timestamptz(6)
  effectiveTo         DateTime?            @db.Timestamptz(6)
  sourceOwnershipRecordId String?          @db.Uuid
  reason              String?              @db.VarChar(512)
  createdById         String?              @db.Uuid
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)

  vehicle               Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  financier             Financier?              @relation(fields: [financierId], references: [id], onDelete: SetNull)
  sourceOwnershipRecord VehicleOwnershipRecord? @relation(fields: [sourceOwnershipRecordId], references: [id], onDelete: SetNull)

  @@index([vehicleId, effectiveFrom])
  @@index([financierId, effectiveFrom])
  @@map("vehicle_financier_history")
}

/// Immutable, append-only vehicle history. Requirement S25: the timeline must
/// not be reconstructed from mutable current-state columns.
model VehicleTimelineEvent {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  vehicleId      String            @db.Uuid
  sessionId      String?           @db.Uuid
  siteId         String?           @db.Uuid
  type           TimelineEventType
  occurredAt     DateTime          @db.Timestamptz(6)
  actorId        String?           @db.Uuid
  actorType      ActorType         @default(SYSTEM)
  actorLabel     String?           @db.VarChar(160)
  title          String            @db.VarChar(200)
  description    String?           @db.VarChar(1000)
  payload        Json?
  correlationId  String?           @db.VarChar(64)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  session      ParkingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  site         Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([vehicleId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([organizationId, type, occurredAt])
  @@map("vehicle_timeline_events")
}

// ===========================================================================
// ANPR
// ===========================================================================

model AnprDevice {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId           String          @db.Uuid
  gateId           String?         @db.Uuid
  laneId           String?         @db.Uuid
  code             String          @db.VarChar(32)
  name             String          @db.VarChar(128)
  /// Provider key resolved by AnprProviderRegistry, e.g. "mock", "generic-webhook".
  provider         String          @db.VarChar(64)
  providerDeviceId String          @db.VarChar(128)
  direction        TravelDirection
  status           DeviceStatus    @default(OFFLINE)
  /// HMAC secret for webhook signature verification. Hash only.
  sharedSecretHash String?         @db.VarChar(128)
  /// Captures below this confidence go to the manual review queue instead of
  /// admitting a vehicle automatically. Overrides the site-level setting.
  confidenceThreshold Decimal?     @db.Decimal(5, 4)
  lastHeartbeatAt  DateTime?       @db.Timestamptz(6)
  lastEventAt      DateTime?       @db.Timestamptz(6)
  firmwareVersion  String?         @db.VarChar(64)
  ipAddress        String?         @db.VarChar(64)
  config           Json?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(6)

  site Site  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  gate Gate? @relation(fields: [gateId], references: [id], onDelete: SetNull)
  lane Lane? @relation(fields: [laneId], references: [id], onDelete: SetNull)

  events AnprEvent[]

  @@unique([siteId, code])
  @@unique([provider, providerDeviceId])
  @@index([siteId, status])
  @@map("anpr_devices")
}

/// A normalised plate-capture event.
///
/// Idempotency is enforced two ways:
///   * `(deviceId, providerEventId)` - the provider's own event id, so a
///     retried webhook delivery is a no-op.
///   * `dedupeKey` - hash of (device, plate, direction, time bucket), so the
///     same physical vehicle triggering several frames is collapsed.
model AnprEvent {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String          @db.Uuid
  deviceId            String          @db.Uuid
  siteId              String          @db.Uuid
  gateId              String?         @db.Uuid
  laneId              String?         @db.Uuid
  providerEventId     String          @db.VarChar(128)
  capturedAt          DateTime        @db.Timestamptz(6)
  receivedAt          DateTime        @default(now()) @db.Timestamptz(6)
  plateNumberRaw      String          @db.VarChar(32)
  normalizedPlate     String          @db.VarChar(16)
  /// 0.0000 - 1.0000 as reported by the recogniser.
  confidence          Decimal         @db.Decimal(5, 4)
  direction           TravelDirection
  vehicleClassHint    VehicleClass?
  status              AnprEventStatus @default(RECEIVED)
  dedupeKey           String          @db.VarChar(128)
  /// Set once the event has been resolved to a vehicle.
  vehicleId           String?         @db.Uuid
  parkingSessionId    String?         @db.Uuid
  /// Overview and plate-crop images live in object storage.
  imageDocumentId     String?         @db.Uuid
  plateImageDocumentId String?        @db.Uuid
  rawPayload          Json?
  /// Manual review, when confidence was below threshold or the plate was
  /// unreadable. Always audited.
  reviewedById        String?         @db.Uuid
  reviewedAt          DateTime?       @db.Timestamptz(6)
  reviewNotes         String?         @db.VarChar(512)
  correctedPlate      String?         @db.VarChar(16)
  processingError     String?         @db.VarChar(512)
  processedAt         DateTime?       @db.Timestamptz(6)
  correlationId       String          @db.VarChar(64)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       AnprDevice      @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  site         Site            @relation(fields: [siteId], references: [id], onDelete: Restrict)
  gate         Gate?           @relation(fields: [gateId], references: [id], onDelete: SetNull)
  lane         Lane?           @relation(fields: [laneId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  entrySessions ParkingSession[] @relation("SessionEntryAnpr")
  exitSessions  ParkingSession[] @relation("SessionExitAnpr")

  @@unique([deviceId, providerEventId])
  @@unique([dedupeKey])
  @@index([siteId, capturedAt])
  @@index([status, receivedAt])
  @@index([normalizedPlate, capturedAt])
  @@index([organizationId, capturedAt])
  @@map("anpr_events")
}

// ===========================================================================
// VEHICLE REGISTRY (VAHAN / authorised aggregator)
// ===========================================================================

/// One attempt to enrich a vehicle from the registry.
///
/// Deliberately a first-class table, not a log line: the requirements flag the
/// VAHAN access route as unresolved (OI-01..OI-03), so per-call cost, latency
/// and failure rate all have to be measurable before a provider is chosen.
model VehicleRegistryLookup {
  id                          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId                   String?      @db.Uuid
  normalizedRegistrationNumber String      @db.VarChar(16)
  provider                    String       @db.VarChar(64)
  status                      LookupStatus @default(QUEUED)
  attempt                     Int          @default(1)
  maxAttempts                 Int          @default(3)
  /// ANPR_ADMISSION | MANUAL | SCHEDULED_REFRESH | RETRY
  triggeredBy                 String       @db.VarChar(32)
  requestedById               String?      @db.Uuid
  requestedAt                 DateTime     @default(now()) @db.Timestamptz(6)
  startedAt                   DateTime?    @db.Timestamptz(6)
  completedAt                 DateTime?    @db.Timestamptz(6)
  latencyMs                   Int?
  httpStatus                  Int?
  errorCode                   String?      @db.VarChar(64)
  errorMessage                String?      @db.VarChar(512)
  /// SHA-256 of the normalised response, to detect "nothing changed" cheaply.
  responseHash                String?      @db.VarChar(64)
  ownershipRecordId           String?      @db.Uuid
  nextRetryAt                 DateTime?    @db.Timestamptz(6)
  correlationId               String       @db.VarChar(64)

  vehicle         Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  ownershipRecord VehicleOwnershipRecord? @relation(fields: [ownershipRecordId], references: [id], onDelete: SetNull)

  @@index([status, nextRetryAt])
  @@index([normalizedRegistrationNumber, requestedAt])
  @@index([vehicleId, requestedAt])
  @@index([provider, requestedAt])
  @@map("vehicle_registry_lookups")
}

// ===========================================================================
// CONTRACT & RATING
// ===========================================================================

model Contract {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  financierId    String         @db.Uuid
  code           String         @db.VarChar(48)
  title          String         @db.VarChar(200)
  status         ContractStatus @default(DRAFT)
  ownerUserId    String?        @db.Uuid
  notes          String?        @db.Text
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  createdById    String?        @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financier    Financier    @relation(fields: [financierId], references: [id], onDelete: Restrict)

  versions ContractVersion[]

  @@unique([organizationId, code])
  @@index([financierId, status])
  @@map("contracts")
}

/// An immutable-once-active commercial agreement.
///
/// Amending terms creates a NEW version; the old one is SUPERSEDED but retained
/// forever, because invoices raised under it must stay reproducible.
model ContractVersion {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId          String                @db.Uuid
  versionNo           Int
  status              ContractVersionStatus @default(DRAFT)
  effectiveFrom       DateTime              @db.Timestamptz(6)
  effectiveTo         DateTime?             @db.Timestamptz(6)
  /// Fallback billing party when no BillingRule matches. Configurable because
  /// the financier-vs-customer matrix is unresolved (OI-06).
  defaultBillingParty BillingPartyType      @default(FINANCIER)
  paymentTermsDays    Int                   @default(30)
  taxProfileId        String?               @db.Uuid
  notes               String?               @db.Text
  approvedById        String?               @db.Uuid
  approvedAt          DateTime?             @db.Timestamptz(6)
  supersededAt        DateTime?             @db.Timestamptz(6)
  version             Int                   @default(0)
  createdById         String?               @db.Uuid
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)

  contract   Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  taxProfile TaxProfile? @relation(fields: [taxProfileId], references: [id], onDelete: SetNull)

  ratePlans    RatePlan[]
  sessions     ParkingSession[]
  billingRules BillingRule[]

  @@unique([contractId, versionNo])
  @@index([status, effectiveFrom, effectiveTo])
  @@map("contract_versions")
}

/// A priced ladder.
///
/// One model serves both business lines, which is what keeps Phase 2 from
/// duplicating the rating engine:
///   scope = CONTRACT     -> attached to a contract version (repossession yard)
///   scope = SITE_TARIFF  -> attached to a site (public parking)
///
/// Resolution picks the highest-`priority` ACTIVE plan whose effective window
/// contains the entry instant and whose `vehicleClass` matches (a NULL class is
/// the catch-all).
model RatePlan {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String         @db.Uuid
  scope               RatePlanScope
  contractVersionId   String?        @db.Uuid
  siteId              String?        @db.Uuid
  /// NULL = applies to every vehicle class.
  vehicleClass        VehicleClass?
  code                String         @db.VarChar(48)
  name                String         @db.VarChar(160)
  description         String?        @db.VarChar(512)
  billingUnit         BillingUnit
  roundingMode        RoundingMode   @default(CEIL)
  /// Units granted at no charge, e.g. 7 free days.
  freeUnits           Decimal        @default(0) @db.Decimal(14, 6)
  freeUnitPolicy      FreeUnitPolicy @default(CONSUME_LADDER)
  /// A stay at or below this is not charged at all.
  graceMinutes        Int            @default(0)
  /// Floor applied after the ladder, before tax.
  minimumChargeAmount Decimal?       @db.Decimal(18, 4)
  /// Ceiling per 24h. Primarily for hourly public-parking tariffs.
  dailyCapAmount      Decimal?       @db.Decimal(18, 4)
  currency            String         @default("INR") @db.VarChar(3)
  effectiveFrom       DateTime       @db.Timestamptz(6)
  effectiveTo         DateTime?      @db.Timestamptz(6)
  status              RatePlanStatus @default(DRAFT)
  /// Higher wins when several plans match.
  priority            Int            @default(100)
  version             Int            @default(0)
  createdById         String?        @db.Uuid
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contractVersion ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)
  site            Site?            @relation(fields: [siteId], references: [id], onDelete: Cascade)

  slabs        RateSlab[]
  sessions     ParkingSession[]
  calculations ChargeCalculation[]

  @@unique([organizationId, code])
  @@index([contractVersionId, status])
  @@index([siteId, status, effectiveFrom])
  @@index([status, effectiveFrom, effectiveTo])
  @@map("rate_plans")
}

/// One rung of a rate ladder, e.g. "days 11-30 at 60/day".
///
/// `fromUnit` is inclusive and 1-based; `toUnit` is inclusive; NULL `toUnit`
/// means "and everything after". Validation enforces that a plan's slabs start
/// at 1, are contiguous, do not overlap, and that only the last is open-ended.
model RateSlab {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ratePlanId  String       @db.Uuid
  sequence    Int
  fromUnit    Decimal      @db.Decimal(14, 6)
  toUnit      Decimal?     @db.Decimal(14, 6)
  kind        RateSlabKind @default(PER_UNIT)
  amount      Decimal      @db.Decimal(18, 4)
  description String?      @db.VarChar(256)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  ratePlan RatePlan    @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  lines    ChargeLine[]

  @@unique([ratePlanId, sequence])
  @@index([ratePlanId, fromUnit])
  @@map("rate_slabs")
}

/// Tax treatment. No rates are hardcoded anywhere in the platform - GST
/// configuration is a business decision Sri JP has not yet supplied (OI-06).
model TaxProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(32)
  name           String   @db.VarChar(128)
  description    String?  @db.VarChar(512)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  components       TaxComponent[]
  sites            Site[]
  contractVersions ContractVersion[]

  @@unique([organizationId, code])
  @@map("tax_profiles")
}

model TaxComponent {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxProfileId String           @db.Uuid
  sequence     Int
  code         String           @db.VarChar(32)
  name         String           @db.VarChar(128)
  kind         TaxComponentKind @default(PERCENTAGE)
  /// Percentage as a fraction, e.g. 0.090000 for 9%. Never hardcoded.
  rate         Decimal          @db.Decimal(9, 6)
  /// Whether the component applies to the subtotal or compounds on the running
  /// total of preceding components.
  base         TaxBase          @default(SUBTOTAL)
  hsnSac       String?          @db.VarChar(16)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  taxProfile TaxProfile @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)

  @@unique([taxProfileId, sequence])
  @@map("tax_components")
}

/// Configurable "who gets billed" rule.
///
/// Requirement S15 with open item OI-06: the financier-vs-customer decision
/// matrix has not been supplied, so it must be data, never code. Rules are
/// evaluated most-specific-scope first, then by descending `priority`; the
/// first whose `conditions` match decides the billing party.
model BillingRule {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String           @db.Uuid
  code              String           @db.VarChar(48)
  name              String           @db.VarChar(160)
  description       String?          @db.VarChar(512)
  scopeType         BillingRuleScope @default(GLOBAL)
  siteId            String?          @db.Uuid
  financierId       String?          @db.Uuid
  contractVersionId String?          @db.Uuid
  priority          Int              @default(100)
  /// Declarative predicate evaluated by BillingRuleEvaluator. Shape:
  /// { "all": [ { "fact": "parkingMode", "op": "eq", "value": "PUBLIC_PARKING" } ] }
  /// An empty object always matches (a catch-all default rule).
  conditions        Json
  outcomePartyType  BillingPartyType
  outcomeNote       String?          @db.VarChar(512)
  effectiveFrom     DateTime         @default(now()) @db.Timestamptz(6)
  effectiveTo       DateTime?        @db.Timestamptz(6)
  isActive          Boolean          @default(true)
  createdById       String?          @db.Uuid
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site            Site?            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  financier       Financier?       @relation(fields: [financierId], references: [id], onDelete: Cascade)
  contractVersion ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, priority])
  @@map("billing_rules")
}

// ===========================================================================
// PARKING SESSION & CHARGES
// ===========================================================================

/// One stay. The single occupancy concept for both business lines.
///
/// A partial unique index (see migration) guarantees at most one non-terminal
/// session per vehicle, which is what makes double-admission impossible even
/// when two gates fire simultaneously.
model ParkingSession {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String               @db.Uuid
  siteId            String               @db.Uuid
  vehicleId         String               @db.Uuid
  sessionNumber     String               @unique @db.VarChar(32)
  parkingMode       ParkingMode
  status            ParkingSessionStatus @default(OPEN)
  entryAt           DateTime             @db.Timestamptz(6)
  exitAt            DateTime?            @db.Timestamptz(6)
  entryGateId       String?              @db.Uuid
  exitGateId        String?              @db.Uuid
  entryLaneId       String?              @db.Uuid
  exitLaneId        String?              @db.Uuid
  entryAnprEventId  String?              @db.Uuid
  exitAnprEventId   String?              @db.Uuid
  /// Resolved at admission and then frozen for the life of the stay, so a
  /// contract renegotiated mid-stay cannot silently re-price a parked vehicle.
  financierId       String?              @db.Uuid
  contractVersionId String?              @db.Uuid
  ratePlanId        String?              @db.Uuid
  /// Full copy of the plan and its slabs as at admission. The charge engine
  /// prefers this over the live rows, guaranteeing reproducibility.
  ratePlanSnapshot  Json?
  /// True when no rate plan could be resolved. The stay still opens (never
  /// block the gate) but the vehicle appears in the "unrated" work queue.
  rateUnresolved    Boolean              @default(false)
  zoneId            String?              @db.Uuid
  spaceId           String?              @db.Uuid
  admissionMethod   AdmissionMethod      @default(ANPR_AUTO)
  admittedById      String?              @db.Uuid
  holdReason        String?              @db.VarChar(512)
  heldById          String?              @db.Uuid
  heldAt            DateTime?            @db.Timestamptz(6)
  closedById        String?              @db.Uuid
  closureReason     String?              @db.VarChar(512)
  correlationId     String?              @db.VarChar(64)
  version           Int                  @default(0)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site            Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  financier       Financier?       @relation(fields: [financierId], references: [id], onDelete: SetNull)
  contractVersion ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)
  ratePlan        RatePlan?        @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  zone            ParkingZone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  space           ParkingSpace?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  entryGate       Gate?            @relation("SessionEntryGate", fields: [entryGateId], references: [id], onDelete: SetNull)
  exitGate        Gate?            @relation("SessionExitGate", fields: [exitGateId], references: [id], onDelete: SetNull)
  entryLane       Lane?            @relation("SessionEntryLane", fields: [entryLaneId], references: [id], onDelete: SetNull)
  exitLane        Lane?            @relation("SessionExitLane", fields: [exitLaneId], references: [id], onDelete: SetNull)
  entryAnprEvent  AnprEvent?       @relation("SessionEntryAnpr", fields: [entryAnprEventId], references: [id], onDelete: SetNull)
  exitAnprEvent   AnprEvent?       @relation("SessionExitAnpr", fields: [exitAnprEventId], references: [id], onDelete: SetNull)

  allocations     ParkingAllocation[]
  calculations    ChargeCalculation[]
  invoices        Invoice[]
  releaseRequests ReleaseRequest[]
  timelineEvents  VehicleTimelineEvent[]
  auctionLots     AuctionLot[]

  @@index([siteId, status, entryAt])
  @@index([vehicleId, status])
  @@index([financierId, status])
  @@index([organizationId, status, entryAt])
  @@index([entryAt])
  @@index([exitAt])
  @@map("parking_sessions")
}

/// Append-only allocation history. A vehicle moved between zones keeps both rows.
model ParkingAllocation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String    @db.Uuid
  zoneId        String    @db.Uuid
  spaceId       String?   @db.Uuid
  allocatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  releasedAt    DateTime? @db.Timestamptz(6)
  allocatedById String?   @db.Uuid
  reason        String?   @db.VarChar(256)

  session ParkingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  zone    ParkingZone    @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  space   ParkingSpace?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  @@index([sessionId, allocatedAt])
  @@index([zoneId, releasedAt])
  @@map("parking_allocations")
}

/// A reproducible charge computation.
///
/// Requirement S14: store the workings, not just the number. Given the same
/// `inputsHash` the engine must produce byte-identical output forever, which is
/// what lets Sri JP defend an invoice to a financier years later.
model ChargeCalculation {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                @db.Uuid
  sessionId          String                @db.Uuid
  type               ChargeCalculationType
  asOf               DateTime              @db.Timestamptz(6)
  engineVersion      String                @db.VarChar(16)
  ratePlanId         String?               @db.Uuid
  ratePlanSnapshot   Json
  timezone           String                @db.VarChar(64)
  billingUnit        BillingUnit
  roundingMode       RoundingMode
  freeUnitPolicy     FreeUnitPolicy
  rawDurationMinutes Int
  graceMinutes       Int                   @default(0)
  totalUnits         Decimal               @db.Decimal(14, 6)
  freeUnits          Decimal               @db.Decimal(14, 6)
  chargeableUnits    Decimal               @db.Decimal(14, 6)
  subtotal           Decimal               @db.Decimal(18, 4)
  taxTotal           Decimal               @db.Decimal(18, 4)
  total              Decimal               @db.Decimal(18, 4)
  currency           String                @db.VarChar(3)
  /// SHA-256 over the canonicalised inputs. Identical inputs, identical hash.
  inputsHash         String                @db.VarChar(64)
  /// Ordered human-readable narrative shown in the console and on the invoice.
  explanation        Json
  /// Exactly one ACCRUAL/ESTIMATE row per session carries this flag.
  isCurrent          Boolean               @default(true)
  calculatedById     String?               @db.Uuid
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      ParkingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ratePlan     RatePlan?      @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)

  lines    ChargeLine[]
  invoices Invoice[]

  @@index([sessionId, type, asOf])
  @@index([sessionId, isCurrent])
  @@index([organizationId, createdAt])
  @@map("charge_calculations")
}

model ChargeLine {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calculationId String         @db.Uuid
  lineNo        Int
  kind          ChargeLineKind
  description   String         @db.VarChar(256)
  fromUnit      Decimal?       @db.Decimal(14, 6)
  toUnit        Decimal?       @db.Decimal(14, 6)
  units         Decimal        @db.Decimal(14, 6)
  unitAmount    Decimal        @db.Decimal(18, 4)
  amount        Decimal        @db.Decimal(18, 4)
  rateSlabId    String?        @db.Uuid

  calculation ChargeCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  rateSlab    RateSlab?         @relation(fields: [rateSlabId], references: [id], onDelete: SetNull)

  @@unique([calculationId, lineNo])
  @@map("charge_lines")
}

// ===========================================================================
// INVOICING & PAYMENT
// ===========================================================================

/// Gap-free invoice numbering. `nextSequence` is incremented inside the same
/// transaction that inserts the invoice, under a row lock.
model InvoiceSeries {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @db.Uuid
  siteId         String?     @db.Uuid
  code           String      @db.VarChar(32)
  name           String      @db.VarChar(128)
  type           InvoiceType @default(PARKING)
  /// e.g. "SJP/PKG/2025-26/"
  prefix         String      @db.VarChar(48)
  financialYear  String?     @db.VarChar(16)
  nextSequence   Int         @default(1)
  padding        Int         @default(6)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  @@unique([organizationId, code])
  @@map("invoice_series")
}

model Invoice {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String           @db.Uuid
  siteId              String           @db.Uuid
  seriesId            String           @db.Uuid
  type                InvoiceType      @default(PARKING)
  status              InvoiceStatus    @default(DRAFT)
  /// Allocated at GENERATED. Unique for the life of the platform.
  invoiceNumber       String           @unique @db.VarChar(48)
  issueDate           DateTime?        @db.Date
  dueDate             DateTime?        @db.Date

  billingPartyType    BillingPartyType
  financierId         String?          @db.Uuid
  bidderId            String?          @db.Uuid
  /// Snapshot of the bill-to party. Copied at generation so a later change to
  /// the master record cannot alter an issued invoice.
  billingPartyName    String           @db.VarChar(256)
  billingPartyAddress String?          @db.VarChar(512)
  billingPartyGstin   String?          @db.VarChar(20)
  billingPartyEmail   String?          @db.VarChar(256)
  billingPartyPhone   String?          @db.VarChar(32)
  /// The rule that decided the billing party, for audit.
  billingRuleId       String?          @db.Uuid

  sessionId           String?          @db.Uuid
  vehicleId           String?          @db.Uuid
  auctionLotId        String?          @db.Uuid
  chargeCalculationId String?          @db.Uuid
  relatedInvoiceId    String?          @db.Uuid

  currency            String           @default("INR") @db.VarChar(3)
  subtotal            Decimal          @default(0) @db.Decimal(18, 4)
  taxTotal            Decimal          @default(0) @db.Decimal(18, 4)
  total               Decimal          @default(0) @db.Decimal(18, 4)
  amountPaid          Decimal          @default(0) @db.Decimal(18, 4)
  /// Maintained transactionally as total - amountPaid.
  balance             Decimal          @default(0) @db.Decimal(18, 4)

  notes               String?          @db.Text
  pdfDocumentId       String?          @db.Uuid
  /// Prevents a retried generation request creating a second invoice.
  idempotencyKey      String           @unique @db.VarChar(128)
  issuedById          String?          @db.Uuid
  issuedAt            DateTime?        @db.Timestamptz(6)
  sentAt              DateTime?        @db.Timestamptz(6)
  voidedById          String?          @db.Uuid
  voidedAt            DateTime?        @db.Timestamptz(6)
  voidReason          String?          @db.VarChar(512)
  correlationId       String?          @db.VarChar(64)
  version             Int              @default(0)
  createdById         String?          @db.Uuid
  createdAt           DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(6)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site              Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  series            InvoiceSeries      @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  financier         Financier?         @relation(fields: [financierId], references: [id], onDelete: Restrict)
  bidder            Bidder?            @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  session           ParkingSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  vehicle           Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  auctionLot        AuctionLot?        @relation(fields: [auctionLotId], references: [id], onDelete: SetNull)
  chargeCalculation ChargeCalculation? @relation(fields: [chargeCalculationId], references: [id], onDelete: SetNull)
  billingRule       BillingRule?       @relation(fields: [billingRuleId], references: [id], onDelete: SetNull)
  relatedInvoice    Invoice?           @relation("InvoiceCreditNote", fields: [relatedInvoiceId], references: [id], onDelete: SetNull)
  creditNotes       Invoice[]          @relation("InvoiceCreditNote")

  lines       InvoiceLine[]
  taxLines    InvoiceTaxLine[]
  payments    Payment[]
  releases    ReleaseRequest[]
  settlements AuctionSettlement[]

  @@index([organizationId, status, issueDate])
  @@index([financierId, status])
  @@index([siteId, status])
  @@index([sessionId])
  @@index([vehicleId])
  @@index([status, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId    String   @db.Uuid
  lineNo       Int
  description  String   @db.VarChar(512)
  quantity     Decimal  @default(1) @db.Decimal(14, 6)
  unitAmount   Decimal  @db.Decimal(18, 4)
  amount       Decimal  @db.Decimal(18, 4)
  hsnSac       String?  @db.VarChar(16)
  chargeLineId String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

model InvoiceTaxLine {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId     String           @db.Uuid
  sequence      Int
  code          String           @db.VarChar(32)
  name          String           @db.VarChar(128)
  kind          TaxComponentKind
  rate          Decimal          @db.Decimal(9, 6)
  taxableAmount Decimal          @db.Decimal(18, 4)
  amount        Decimal          @db.Decimal(18, 4)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, sequence])
  @@map("invoice_tax_lines")
}

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String        @db.Uuid
  invoiceId             String        @db.Uuid
  amount                Decimal       @db.Decimal(18, 4)
  currency              String        @default("INR") @db.VarChar(3)
  method                PaymentMethod
  /// Provider key, e.g. "manual", "mock-gateway".
  provider              String        @db.VarChar(64)
  providerOrderId       String?       @db.VarChar(128)
  providerTransactionId String?       @db.VarChar(128)
  status                PaymentStatus @default(INITIATED)
  initiatedAt           DateTime      @default(now()) @db.Timestamptz(6)
  completedAt           DateTime?     @db.Timestamptz(6)
  failureReason         String?       @db.VarChar(512)
  /// Cheque number, UTR, receipt number and similar.
  reference             String?       @db.VarChar(128)
  receivedById          String?       @db.Uuid
  metadata              Json?
  /// A retried "record payment" call must not double-credit an invoice.
  idempotencyKey        String        @unique @db.VarChar(128)
  correlationId         String?       @db.VarChar(64)
  version               Int           @default(0)
  createdAt             DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  webhookEvents PaymentWebhookEvent[]

  @@index([invoiceId, status])
  @@index([organizationId, status, completedAt])
  @@index([provider, providerTransactionId])
  @@map("payments")
}

/// Raw gateway callbacks.
///
/// Persisted BEFORE processing and keyed on the provider's event id, so a
/// duplicate delivery can never apply a payment twice. A payment is only ever
/// marked SUCCESS from one of these rows - never from a browser request.
model PaymentWebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String    @db.VarChar(64)
  providerEventId String    @db.VarChar(128)
  eventType       String    @db.VarChar(64)
  signatureValid  Boolean
  payload         Json
  receivedAt      DateTime  @default(now()) @db.Timestamptz(6)
  processedAt     DateTime? @db.Timestamptz(6)
  paymentId       String?   @db.Uuid
  processingError String?   @db.VarChar(512)
  correlationId   String    @db.VarChar(64)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([processedAt])
  @@map("payment_webhook_events")
}

// ===========================================================================
// RELEASE
// ===========================================================================

model ReleaseRequest {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String               @db.Uuid
  siteId                String               @db.Uuid
  sessionId             String               @db.Uuid
  vehicleId             String               @db.Uuid
  requestNumber         String               @unique @db.VarChar(32)
  status                ReleaseRequestStatus @default(DRAFT)
  requestedById         String               @db.Uuid
  requestedAt           DateTime             @default(now()) @db.Timestamptz(6)
  /// Who is collecting the vehicle.
  requestedForPartyType BillingPartyType
  requestedForName      String?              @db.VarChar(256)
  requestedForPhone     String?              @db.VarChar(32)
  requestedForIdRef     String?              @db.VarChar(128)
  reason                String               @db.VarChar(512)
  /// Frozen result of the eligibility check: holds, balances, auction status.
  eligibilitySnapshot   Json?
  eligibilityCheckedAt  DateTime?            @db.Timestamptz(6)
  chargeCalculationId   String?              @db.Uuid
  invoiceId             String?              @db.Uuid
  approvedById          String?              @db.Uuid
  approvedAt            DateTime?            @db.Timestamptz(6)
  rejectedById          String?              @db.Uuid
  rejectedAt            DateTime?            @db.Timestamptz(6)
  rejectionReason       String?              @db.VarChar(512)
  /// One-time gate code handed to the yard. Hash only, with an expiry.
  authorizationCodeHash String?              @db.VarChar(128)
  authorizationExpiresAt DateTime?           @db.Timestamptz(6)
  completedAt           DateTime?            @db.Timestamptz(6)
  completedById         String?              @db.Uuid
  exitAnprEventId       String?              @db.Uuid
  correlationId         String?              @db.VarChar(64)
  version               Int                  @default(0)
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  session      ParkingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  invoice      Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  approvals ReleaseApproval[]

  @@index([siteId, status, requestedAt])
  @@index([sessionId])
  @@index([vehicleId, status])
  @@index([organizationId, status])
  @@map("release_requests")
}

/// Append-only approval log. Protected against UPDATE/DELETE by trigger.
model ReleaseApproval {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releaseRequestId String           @db.Uuid
  approverId       String           @db.Uuid
  decision         ApprovalDecision
  remarks          String?          @db.VarChar(512)
  decidedAt        DateTime         @default(now()) @db.Timestamptz(6)
  ipAddress        String?          @db.VarChar(64)
  userAgent        String?          @db.VarChar(512)
  correlationId    String?          @db.VarChar(64)

  releaseRequest ReleaseRequest @relation(fields: [releaseRequestId], references: [id], onDelete: Cascade)

  @@index([releaseRequestId, decidedAt])
  @@index([approverId, decidedAt])
  @@map("release_approvals")
}

// ===========================================================================
// AUCTION
// ===========================================================================

model Auction {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String        @db.Uuid
  siteId              String?       @db.Uuid
  code                String        @db.VarChar(32)
  title               String        @db.VarChar(200)
  description         String?       @db.Text
  status              AuctionStatus @default(DRAFT)
  scheduledStartAt    DateTime      @db.Timestamptz(6)
  scheduledEndAt      DateTime      @db.Timestamptz(6)
  actualStartAt       DateTime?     @db.Timestamptz(6)
  actualEndAt         DateTime?     @db.Timestamptz(6)
  defaultMinIncrement Decimal       @db.Decimal(18, 4)
  currency            String        @default("INR") @db.VarChar(3)
  termsAndConditions  String?       @db.Text
  /// Deposit a bidder must lodge to register. Configurable, never assumed.
  registrationDeposit Decimal?      @db.Decimal(18, 4)
  publishedById       String?       @db.Uuid
  publishedAt         DateTime?     @db.Timestamptz(6)
  closedById          String?       @db.Uuid
  closedAt            DateTime?     @db.Timestamptz(6)
  cancelledReason     String?       @db.VarChar(512)
  version             Int           @default(0)
  createdById         String?       @db.Uuid
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  lots          AuctionLot[]
  registrations AuctionRegistration[]
  settlements   AuctionSettlement[]

  @@unique([organizationId, code])
  @@index([organizationId, status, scheduledStartAt])
  @@map("auctions")
}

model AuctionLot {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auctionId          String           @db.Uuid
  lotNumber          Int
  vehicleId          String           @db.Uuid
  sessionId          String?          @db.Uuid
  status             AuctionLotStatus @default(DRAFT)
  reservePrice       Decimal          @db.Decimal(18, 4)
  startingPrice      Decimal?         @db.Decimal(18, 4)
  minIncrement       Decimal          @db.Decimal(18, 4)
  currency           String           @default("INR") @db.VarChar(3)
  description        String?          @db.Text
  conditionNotes     String?          @db.Text
  /// Denormalised, maintained transactionally with each accepted bid.
  bidCount           Int              @default(0)
  highestBidAmount   Decimal?         @db.Decimal(18, 4)
  winningBidId       String?          @db.Uuid @unique
  winnerBidderId     String?          @db.Uuid
  winnerSelectedById String?          @db.Uuid
  winnerSelectedAt   DateTime?        @db.Timestamptz(6)
  withdrawnReason    String?          @db.VarChar(512)
  version            Int              @default(0)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  auction    Auction         @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  session    ParkingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  winningBid Bid?            @relation("LotWinningBid", fields: [winningBidId], references: [id], onDelete: SetNull)
  winner     Bidder?         @relation("LotWinner", fields: [winnerBidderId], references: [id], onDelete: SetNull)

  bids       Bid[]              @relation("LotBids")
  settlement AuctionSettlement?
  invoices   Invoice[]

  @@unique([auctionId, lotNumber])
  @@unique([auctionId, vehicleId])
  @@index([auctionId, status])
  @@index([vehicleId])
  @@map("auction_lots")
}

model Bidder {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  code           String       @db.VarChar(32)
  legalName      String       @db.VarChar(256)
  displayName    String       @db.VarChar(128)
  contactName    String       @db.VarChar(160)
  phone          String       @db.VarChar(32)
  email          String?      @db.VarChar(256)
  addressLine1   String?      @db.VarChar(256)
  city           String?      @db.VarChar(128)
  state          String?      @db.VarChar(128)
  postalCode     String?      @db.VarChar(16)
  pan            String?      @db.VarChar(16)
  gstin          String?      @db.VarChar(20)
  status         BidderStatus @default(REGISTERED)
  kycVerifiedAt  DateTime?    @db.Timestamptz(6)
  kycVerifiedById String?     @db.Uuid
  /// Optional portal login for the bidder.
  userId         String?      @unique @db.Uuid
  approvedById   String?      @db.Uuid
  approvedAt     DateTime?    @db.Timestamptz(6)
  blacklistReason String?     @db.VarChar(512)
  notes          String?      @db.Text
  version        Int          @default(0)
  createdById    String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  registrations AuctionRegistration[]
  bids          Bid[]
  wonLots       AuctionLot[]          @relation("LotWinner")
  settlements   AuctionSettlement[]
  invoices      Invoice[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("bidders")
}

model AuctionRegistration {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auctionId       String                    @db.Uuid
  bidderId        String                    @db.Uuid
  status          AuctionRegistrationStatus @default(PENDING)
  depositPaid     Decimal                   @default(0) @db.Decimal(18, 4)
  depositReference String?                  @db.VarChar(128)
  registeredAt    DateTime                  @default(now()) @db.Timestamptz(6)
  approvedById    String?                   @db.Uuid
  approvedAt      DateTime?                 @db.Timestamptz(6)
  rejectionReason String?                   @db.VarChar(512)
  version         Int                       @default(0)

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  Bidder  @relation(fields: [bidderId], references: [id], onDelete: Restrict)

  @@unique([auctionId, bidderId])
  @@index([auctionId, status])
  @@map("auction_registrations")
}

/// A bid.
///
/// Requirement S18/S19: bids are immutable business records. A database trigger
/// rejects any UPDATE that touches `lotId`, `bidderId`, `amount`, `placedAt` or
/// `sequenceNo`, and rejects every DELETE. Only `status` may advance, and each
/// change is recorded in `bid_events`.
///
/// `(lotId, sequenceNo)` is unique, which serialises concurrent bids: two
/// simultaneous bidders cannot both take sequence N.
model Bid {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId          String     @db.Uuid
  bidderId       String     @db.Uuid
  amount         Decimal    @db.Decimal(18, 4)
  currency       String     @default("INR") @db.VarChar(3)
  sequenceNo     Int
  placedAt       DateTime   @default(now()) @db.Timestamptz(6)
  status         BidStatus  @default(ACCEPTED)
  channel        BidChannel @default(PORTAL)
  /// Set when an auction administrator entered the bid for a hall bidder.
  placedById     String?    @db.Uuid
  placedOnBehalf Boolean    @default(false)
  ipAddress      String?    @db.VarChar(64)
  userAgent      String?    @db.VarChar(512)
  idempotencyKey String     @unique @db.VarChar(128)
  correlationId  String     @db.VarChar(64)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)

  lot    AuctionLot @relation("LotBids", fields: [lotId], references: [id], onDelete: Restrict)
  bidder Bidder     @relation(fields: [bidderId], references: [id], onDelete: Restrict)

  wonLot AuctionLot? @relation("LotWinningBid")
  events BidEvent[]

  @@unique([lotId, sequenceNo])
  @@index([lotId, amount])
  @@index([lotId, placedAt])
  @@index([bidderId, placedAt])
  @@map("bids")
}

/// Append-only history of bid status changes.
model BidEvent {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bidId      String     @db.Uuid
  fromStatus BidStatus?
  toStatus   BidStatus
  reason     String?    @db.VarChar(256)
  actorId    String?    @db.Uuid
  actorType  ActorType  @default(SYSTEM)
  occurredAt DateTime   @default(now()) @db.Timestamptz(6)

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId, occurredAt])
  @@map("bid_events")
}

model AuctionSettlement {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auctionId      String           @db.Uuid
  lotId          String           @unique @db.Uuid
  bidderId       String           @db.Uuid
  winningBidId   String           @db.Uuid
  saleAmount     Decimal          @db.Decimal(18, 4)
  /// Buyer's premium, documentation and similar. Configurable per auction.
  feesAmount     Decimal          @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal          @default(0) @db.Decimal(18, 4)
  totalPayable   Decimal          @db.Decimal(18, 4)
  amountReceived Decimal          @default(0) @db.Decimal(18, 4)
  currency       String           @default("INR") @db.VarChar(3)
  status         SettlementStatus @default(PENDING)
  dueDate        DateTime?        @db.Date
  settledAt      DateTime?        @db.Timestamptz(6)
  settledById    String?          @db.Uuid
  saleInvoiceId  String?          @db.Uuid
  defaultReason  String?          @db.VarChar(512)
  notes          String?          @db.Text
  version        Int              @default(0)
  createdById    String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  auction     Auction    @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  lot         AuctionLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  bidder      Bidder     @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  saleInvoice Invoice?   @relation(fields: [saleInvoiceId], references: [id], onDelete: SetNull)

  @@index([auctionId, status])
  @@index([bidderId, status])
  @@map("auction_settlements")
}

// ===========================================================================
// NOTIFICATION
// ===========================================================================

model NotificationTemplate {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @db.Uuid
  code           String              @db.VarChar(64)
  channel        NotificationChannel
  locale         String              @default("en") @db.VarChar(8)
  name           String              @db.VarChar(160)
  description    String?             @db.VarChar(512)
  subjectTemplate String?            @db.VarChar(512)
  /// Mustache-style {{placeholders}}. Rendered by a strict renderer that
  /// refuses to send when a declared variable is missing.
  bodyTemplate   String              @db.Text
  variables      String[]
  isActive       Boolean             @default(true)
  revision       Int                 @default(1)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  updatedById    String?             @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code, channel, locale])
  @@map("notification_templates")
}

model Notification {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String              @db.Uuid
  templateCode    String              @db.VarChar(64)
  channel         NotificationChannel
  /// Masked for display, e.g. "98****3210" / "a***@example.com".
  recipientMasked String              @db.VarChar(256)
  /// Encrypted at rest by the application. Never logged.
  recipientCipher String              @db.VarChar(1024)
  subject         String?             @db.VarChar(512)
  bodyPreview     String?             @db.VarChar(512)
  payload         Json?
  status          NotificationStatus  @default(QUEUED)
  provider        String?             @db.VarChar(64)
  providerMessageId String?           @db.VarChar(128)
  attempts        Int                 @default(0)
  maxAttempts     Int                 @default(5)
  lastError       String?             @db.VarChar(512)
  queuedAt        DateTime            @default(now()) @db.Timestamptz(6)
  sentAt          DateTime?           @db.Timestamptz(6)
  deliveredAt     DateTime?           @db.Timestamptz(6)
  failedAt        DateTime?           @db.Timestamptz(6)
  nextRetryAt     DateTime?           @db.Timestamptz(6)
  entityType      String?             @db.VarChar(48)
  entityId        String?             @db.Uuid
  idempotencyKey  String              @unique @db.VarChar(128)
  correlationId   String              @db.VarChar(64)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([organizationId, channel, status])
  @@index([entityType, entityId])
  @@map("notifications")
}

// ===========================================================================
// DOCUMENTS
// ===========================================================================

/// Metadata only. Binary content lives in S3-compatible object storage; the
/// database never holds the bytes.
model Document {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  siteId         String?      @db.Uuid
  kind           DocumentKind
  entityType     String       @db.VarChar(48)
  entityId       String?      @db.Uuid
  fileName       String       @db.VarChar(256)
  contentType    String       @db.VarChar(128)
  sizeBytes      Int
  /// Key in the object store. Unique, and never derived from user input.
  objectKey      String       @unique @db.VarChar(512)
  checksumSha256 String       @db.VarChar(64)
  scanStatus     ScanStatus   @default(PENDING)
  scannedAt      DateTime?    @db.Timestamptz(6)
  uploadedById   String?      @db.Uuid
  uploadedAt     DateTime     @default(now()) @db.Timestamptz(6)
  metadata       Json?
  retentionUntil DateTime?    @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([organizationId, kind, uploadedAt])
  @@map("documents")
}

// ===========================================================================
// AUDIT, INTEGRATION LOG, OUTBOX, IDEMPOTENCY, SETTINGS, JOBS
// ===========================================================================

/// Append-only audit trail. Requirement S27.
///
/// Protected by a trigger that rejects UPDATE and DELETE outright, so not even
/// a database superuser can quietly rewrite history through the application
/// role. `beforeState`/`afterState` are redacted of secrets before insertion.
model AuditLog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?      @db.Uuid
  occurredAt     DateTime     @default(now()) @db.Timestamptz(6)
  actorId        String?      @db.Uuid
  actorType      ActorType    @default(USER)
  actorLabel     String?      @db.VarChar(256)
  actorRoles     String[]
  action         String       @db.VarChar(96)
  entityType     String       @db.VarChar(64)
  entityId       String?      @db.VarChar(64)
  siteId         String?      @db.Uuid
  beforeState    Json?
  afterState     Json?
  changedFields  String[]
  ipAddress      String?      @db.VarChar(64)
  userAgent      String?      @db.VarChar(512)
  correlationId  String       @db.VarChar(64)
  requestId      String?      @db.VarChar(64)
  reason         String?      @db.VarChar(512)
  outcome        AuditOutcome @default(SUCCESS)
  errorCode      String?      @db.VarChar(64)

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([action, occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}

/// Every call across an integration boundary, in or out.
model IntegrationLog {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String?               @db.Uuid
  kind            IntegrationKind
  provider        String                @db.VarChar(64)
  operation       String                @db.VarChar(96)
  /// OUTBOUND | INBOUND
  direction       String                @db.VarChar(16)
  status          IntegrationCallStatus
  httpStatus      Int?
  latencyMs       Int?
  attempt         Int                   @default(1)
  /// Summaries only - never full payloads, never credentials.
  requestSummary  Json?
  responseSummary Json?
  errorCode       String?               @db.VarChar(64)
  errorMessage    String?               @db.VarChar(512)
  entityType      String?               @db.VarChar(48)
  entityId        String?               @db.VarChar(64)
  correlationId   String                @db.VarChar(64)
  occurredAt      DateTime              @default(now()) @db.Timestamptz(6)

  @@index([kind, provider, occurredAt])
  @@index([status, occurredAt])
  @@index([correlationId])
  @@map("integration_logs")
}

/// Transactional outbox.
///
/// Domain events are written in the SAME transaction as the state change that
/// produced them, then relayed asynchronously. This is what makes "vehicle
/// admitted but no session created" impossible, and lets the platform move to
/// Kafka/RabbitMQ later without touching a single domain service.
model OutboxEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String       @db.VarChar(64)
  aggregateId   String       @db.VarChar(64)
  eventType     String       @db.VarChar(96)
  payload       Json
  occurredAt    DateTime     @default(now()) @db.Timestamptz(6)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(10)
  publishedAt   DateTime?    @db.Timestamptz(6)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(6)
  lastError     String?      @db.VarChar(512)
  correlationId String       @db.VarChar(64)

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Server-side idempotency for unsafe HTTP methods.
///
/// The row is inserted IN_PROGRESS before the handler runs; a concurrent retry
/// therefore collides on the unique key and is told the request is in flight
/// rather than executing the operation twice.
model IdempotencyRecord {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope          String           @db.VarChar(96)
  key            String           @db.VarChar(128)
  /// SHA-256 of the request body. A reused key with a different body is an error.
  requestHash    String           @db.VarChar(64)
  state          IdempotencyState @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  userId         String?          @db.Uuid
  correlationId  String           @db.VarChar(64)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  completedAt    DateTime?        @db.Timestamptz(6)
  expiresAt      DateTime         @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Business configuration. Changing operational behaviour must never require a
/// code change or a redeploy (requirement S41).
model SystemSetting {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  scope          SettingScope    @default(GLOBAL)
  siteId         String?         @db.Uuid
  /// Sentinel so the uniqueness rule works: siteId, or the literal 'GLOBAL'.
  /// PostgreSQL treats NULLs as distinct, which would allow duplicate keys.
  siteScopeKey   String          @default("GLOBAL") @db.VarChar(64)
  key            String          @db.VarChar(128)
  valueJson      Json
  dataType       SettingDataType @default(STRING)
  description    String          @db.VarChar(512)
  /// Secret settings are never returned by the read API; only "is set".
  isSecret       Boolean         @default(false)
  updatedById    String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([organizationId, siteScopeKey, key])
  @@index([organizationId, scope])
  @@map("system_settings")
}

/// Background job observability.
model JobRun {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobName        String       @db.VarChar(96)
  status         JobRunStatus @default(RUNNING)
  /// SCHEDULE | MANUAL | RETRY
  triggeredBy    String       @db.VarChar(24)
  triggeredById  String?      @db.Uuid
  startedAt      DateTime     @default(now()) @db.Timestamptz(6)
  finishedAt     DateTime?    @db.Timestamptz(6)
  durationMs     Int?
  itemsProcessed Int          @default(0)
  itemsFailed    Int          @default(0)
  error          String?      @db.VarChar(1000)
  metadata       Json?
  correlationId  String       @db.VarChar(64)

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@map("job_runs")
}
