// ---------------------------------------------------------------------------
// SmartPark Enterprise - relational domain model
//
// Conventions applied throughout:
//
//   * Money      NUMERIC(18,4). Never a float. Serialised to the wire as a
//                decimal string; computed with decimal.js.
//   * Units      NUMERIC(14,6) so fractional hours/days survive rounding.
//   * Identity   UUID v4 generated by the database (pgcrypto).
//   * Concurrency  Mutable aggregates carry `version Int`, used for optimistic
//                locking. Any UPDATE must match the version it read.
//   * History    Financially or legally significant tables are append-only and
//                are additionally protected by database triggers (see the
//                `immutability_guards` migration): audit_logs, bids,
//                vehicle_timeline_events, release_approvals, bid_events.
//   * Audit      Mutable business tables carry created/updated actor + time.
//   * Deletes    There are no hard deletes on business records. Entities carry
//                a lifecycle status; only genuinely transient rows (idempotency
//                records, expired refresh tokens) are physically removed.
//
// Enum values are mirrored 1:1 in packages/contracts/src/enums.ts.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

