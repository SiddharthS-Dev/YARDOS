// ===========================================================================
// TENANCY, IDENTITY & ACCESS
// ===========================================================================

/// The operating company. Modelled as a first-class tenant root so the platform
/// can host more than one operator later without a schema change.
model Organization {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String   @unique @db.VarChar(32)
  legalName      String   @db.VarChar(256)
  displayName    String   @db.VarChar(128)
  gstin          String?  @db.VarChar(20)
  pan            String?  @db.VarChar(16)
  addressLine1   String?  @db.VarChar(256)
  addressLine2   String?  @db.VarChar(256)
  city           String?  @db.VarChar(128)
  state          String?  @db.VarChar(128)
  postalCode     String?  @db.VarChar(16)
  country        String   @default("IN") @db.VarChar(2)
  contactEmail   String?  @db.VarChar(256)
  contactPhone   String?  @db.VarChar(32)
  /// IANA timezone used when a site does not override it.
  timezone       String   @default("Asia/Kolkata") @db.VarChar(64)
  defaultCurrency String  @default("INR") @db.VarChar(3)
  logoDocumentId String?  @db.Uuid
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  sites                 Site[]
  users                 User[]
  roles                 Role[]
  financiers            Financier[]
  vehicles              Vehicle[]
  anprEvents            AnprEvent[]
  contracts             Contract[]
  ratePlans             RatePlan[]
  taxProfiles           TaxProfile[]
  billingRules          BillingRule[]
  parkingSessions       ParkingSession[]
  chargeCalculations    ChargeCalculation[]
  invoiceSeries         InvoiceSeries[]
  invoices              Invoice[]
  payments              Payment[]
  releaseRequests       ReleaseRequest[]
  auctions              Auction[]
  bidders               Bidder[]
  notificationTemplates NotificationTemplate[]
  notifications         Notification[]
  documents             Document[]
  timelineEvents        VehicleTimelineEvent[]
  systemSettings        SystemSetting[]

  @@map("organizations")
}

/// A physical location. Covers both Phase 1 repossession yards and the Phase 2
/// airport / metro / railway parking sites, which differ only by `siteType`
/// and `parkingMode`.
model Site {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @db.Uuid
  code           String      @db.VarChar(32)
  name           String      @db.VarChar(160)
  siteType       SiteType
  parkingMode    ParkingMode
  status         SiteStatus  @default(PLANNED)
  /// IANA timezone. All calendar-day billing arithmetic uses the SITE zone,
  /// never the server zone - a yard in a different zone must bill correctly.
  timezone       String      @default("Asia/Kolkata") @db.VarChar(64)
  addressLine1   String?     @db.VarChar(256)
  addressLine2   String?     @db.VarChar(256)
  city           String?     @db.VarChar(128)
  state          String?     @db.VarChar(128)
  postalCode     String?     @db.VarChar(16)
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  /// Nominal capacity. Zone capacities are authoritative for allocation.
  totalCapacity  Int         @default(0)
  contactName    String?     @db.VarChar(128)
  contactPhone   String?     @db.VarChar(32)
  contactEmail   String?     @db.VarChar(256)
  /// Default tax treatment for invoices raised at this site.
  taxProfileId   String?     @db.Uuid
  goLiveDate     DateTime?   @db.Date
  notes          String?     @db.Text
  version        Int         @default(0)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  taxProfile   TaxProfile?  @relation(fields: [taxProfileId], references: [id], onDelete: SetNull)

  gates            Gate[]
  zones            ParkingZone[]
  anprDevices      AnprDevice[]
  anprEvents       AnprEvent[]
  ratePlans        RatePlan[]
  parkingSessions  ParkingSession[]
  invoices         Invoice[]
  invoiceSeries    InvoiceSeries[]
  releaseRequests  ReleaseRequest[]
  auctions         Auction[]
  documents        Document[]
  userAccess       UserSiteAccess[]
  billingRules     BillingRule[]
  systemSettings   SystemSetting[]
  vehiclesPresent  Vehicle[]              @relation("VehicleCurrentSite")
  timelineEvents   VehicleTimelineEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([siteType])
  @@index([parkingMode])
  @@map("sites")
}

model Gate {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId    String          @db.Uuid
  code      String          @db.VarChar(32)
  name      String          @db.VarChar(128)
  direction TravelDirection @default(BIDIRECTIONAL)
  status    GateStatus      @default(ONLINE)
  notes     String?         @db.Text
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @db.Timestamptz(6)

  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)

  lanes           Lane[]
  anprDevices     AnprDevice[]
  anprEvents      AnprEvent[]
  entrySessions   ParkingSession[] @relation("SessionEntryGate")
  exitSessions    ParkingSession[] @relation("SessionExitGate")

  @@unique([siteId, code])
  @@index([siteId, status])
  @@map("gates")
}

model Lane {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gateId    String          @db.Uuid
  code      String          @db.VarChar(32)
  name      String          @db.VarChar(128)
  direction TravelDirection
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @db.Timestamptz(6)

  gate Gate @relation(fields: [gateId], references: [id], onDelete: Restrict)

  anprDevices   AnprDevice[]
  anprEvents    AnprEvent[]
  entrySessions ParkingSession[] @relation("SessionEntryLane")
  exitSessions  ParkingSession[] @relation("SessionExitLane")

  @@unique([gateId, code])
  @@map("lanes")
}

model ParkingZone {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId         String         @db.Uuid
  code           String         @db.VarChar(32)
  name           String         @db.VarChar(128)
  /// Hard capacity. Allocation refuses to exceed it.
  capacity       Int
  /// Vehicle classes this zone accepts. Empty = any class.
  allowedClasses VehicleClass[]
  isActive       Boolean        @default(true)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)

  spaces      ParkingSpace[]
  sessions    ParkingSession[]
  allocations ParkingAllocation[]

  @@unique([siteId, code])
  @@index([siteId, isActive])
  @@map("parking_zones")
}

model ParkingSpace {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId    String             @db.Uuid
  code      String             @db.VarChar(32)
  status    ParkingSpaceStatus @default(AVAILABLE)
  notes     String?            @db.VarChar(512)
  version   Int                @default(0)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)

  zone ParkingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  sessions    ParkingSession[]
  allocations ParkingAllocation[]

  @@unique([zoneId, code])
  @@index([zoneId, status])
  @@map("parking_spaces")
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String     @db.Uuid
  /// Stored lowercase; the unique index is on the lowercased value.
  email               String     @unique @db.VarChar(256)
  fullName            String     @db.VarChar(160)
  phone               String?    @db.VarChar(32)
  /// Hash only. The plaintext password never leaves the request handler.
  passwordHash        String     @db.VarChar(512)
  /// Algorithm + parameters, so hashes can be upgraded in place on next login.
  passwordAlgorithm   String     @default("scrypt") @db.VarChar(32)
  passwordUpdatedAt   DateTime   @default(now()) @db.Timestamptz(6)
  mustChangePassword  Boolean    @default(false)
  status              UserStatus @default(INVITED)
  /// Set for financier-portal users. Every read they perform is narrowed to it.
  financierId         String?    @db.Uuid
  mfaEnabled          Boolean    @default(false)
  mfaSecretEncrypted  String?    @db.VarChar(512)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(6)
  lastLoginAt         DateTime?  @db.Timestamptz(6)
  lastLoginIp         String?    @db.VarChar(64)
  isServiceAccount    Boolean    @default(false)
  version             Int        @default(0)
  createdAt           DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(6)
  createdById         String?    @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financier    Financier?   @relation(fields: [financierId], references: [id], onDelete: Restrict)

  roles         UserRole[]       @relation("UserRoleUser")
  grantedRoles  UserRole[]       @relation("UserRoleGranter")
  siteAccess    UserSiteAccess[]
  refreshTokens RefreshToken[]
  bidder        Bidder?

  @@index([organizationId, status])
  @@index([financierId])
  @@map("users")
}

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(64)
  name           String   @db.VarChar(128)
  description    String?  @db.VarChar(512)
  /// System roles are seeded and cannot be deleted or renamed.
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(64)
  category    String   @db.VarChar(64)
  description String   @db.VarChar(512)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  grantedById String?  @db.Uuid
  grantedAt   DateTime @default(now()) @db.Timestamptz(6)

  user      User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("UserRoleGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Per-user site grants. A user without `site:access:all` sees only these sites.
model UserSiteAccess {
  userId    String   @db.Uuid
  siteId    String   @db.Uuid
  grantedAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
  @@map("user_site_access")
}

/// Rotating refresh tokens. Only the SHA-256 hash is stored. Tokens are grouped
/// into a `familyId`; presenting an already-rotated token revokes the whole
/// family, which detects token theft.
model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique @db.VarChar(128)
  familyId          String    @db.Uuid
  issuedAt          DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  revokedReason     String?   @db.VarChar(128)
  replacedByTokenId String?   @db.Uuid
  ipAddress         String?   @db.VarChar(64)
  userAgent         String?   @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Append-only login attempt log. Drives account lockout and security audit.
model LoginAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lowercased email as supplied. Retained even when no such user exists.
  email     String   @db.VarChar(256)
  userId    String?  @db.Uuid
  success   Boolean
  reason    String?  @db.VarChar(64)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  attemptedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([email, attemptedAt])
  @@index([userId, attemptedAt])
  @@map("login_attempts")
}

