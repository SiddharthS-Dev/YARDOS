{
  "name": "smartpark-enterprise",
  "version": "1.0.0",
  "private": true,
  "description": "SmartPark Enterprise - Vehicle Yard, Parking, Billing, Auction & Financier Intelligence Platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@smartpark/contracts && npm run build --workspace=@smartpark/api",
    "build:contracts": "npm run build --workspace=@smartpark/contracts",
    "build:api": "npm run build --workspace=@smartpark/api",
    "build:web": "npm run build --workspace=@smartpark/web",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev --workspace=@smartpark/api\" \"npm run dev --workspace=@smartpark/web\"",
    "dev:api": "npm run dev --workspace=@smartpark/api",
    "dev:web": "npm run dev --workspace=@smartpark/web",
    "lint": "npm run lint --workspace=@smartpark/api",
    "typecheck": "npm run typecheck --workspace=@smartpark/contracts && npm run typecheck --workspace=@smartpark/api",
    "test": "npm run test --workspace=@smartpark/api",
    "test:unit": "npm run test:unit --workspace=@smartpark/api",
    "test:integration": "npm run test:integration --workspace=@smartpark/api",
    "test:e2e": "npm run test:e2e --workspace=@smartpark/api",
    "test:cov": "npm run test:cov --workspace=@smartpark/api",
    "db:generate": "npm run db:generate --workspace=@smartpark/api",
    "db:migrate": "npm run db:migrate --workspace=@smartpark/api",
    "db:deploy": "npm run db:deploy --workspace=@smartpark/api",
    "db:reset": "npm run db:reset --workspace=@smartpark/api",
    "db:seed": "npm run db:seed --workspace=@smartpark/api",
    "db:studio": "npm run db:studio --workspace=@smartpark/api",
    "stack:up": "docker compose -f docker/docker-compose.yml up -d",
    "stack:down": "docker compose -f docker/docker-compose.yml down",
    "stack:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "stack:reset": "docker compose -f docker/docker-compose.yml down -v"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "deepmerge-ts": "^8.0.2",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
