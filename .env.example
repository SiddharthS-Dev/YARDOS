# ---------------------------------------------------------------------------
# SmartPark Enterprise - environment template
#
# Copy to `.env` for local development:   cp .env.example .env
#
# RULES
#   * `.env` is git-ignored. Never commit real credentials.
#   * In staging/production these values come from the platform secret store
#     (Kubernetes Secret / AWS Secrets Manager / Vault), NOT from a file on disk.
#   * The API refuses to boot if a secret is missing, too short, or still set to
#     a value from this template while NODE_ENV=production. See
#     apps/api/src/config/configuration.ts.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_VERSION=1.0.0
# Comma-separated. Use exact origins in production; never "*".
CORS_ORIGINS=http://localhost:3001

# --- Logging & observability ----------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Human-readable logs locally; ALWAYS false in production (structured JSON).
LOG_PRETTY=true
# Sampled request logging, 0.0 - 1.0.
LOG_REQUEST_SAMPLE_RATE=1.0

# --- PostgreSQL ------------------------------------------------------------
# Port 5442 matches docker/docker-compose.yml, which deliberately avoids 5432/5433
# so it cannot collide with a locally installed PostgreSQL. If 5442 is taken on
# your machine, set POSTGRES_PORT and update DATABASE_URL to match.
DATABASE_URL=postgresql://smartpark:smartpark_dev_only@localhost:5442/smartpark?schema=public
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Redis -----------------------------------------------------------------
# Used for the job queue, ANPR de-duplication windows, rate limiting and
# reference-data caching.
REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=smartpark

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. The two secrets MUST differ.
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-value-access-0000
JWT_REFRESH_SECRET=replace-me-with-a-48-byte-random-value-refresh-000
JWT_ISSUER=smartpark-enterprise
JWT_AUDIENCE=smartpark-console
# Short-lived access token.
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime; rotated on every use.
JWT_REFRESH_TTL_SECONDS=2592000

# Application-level encryption key for data encrypted at rest by the app
# (notification recipients, TOTP secrets). Exactly 32 bytes, base64-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=cmVwbGFjZS1tZS0zMi1ieXRlLWtleS1iYXNlNjQtMDAwMDA=

# Account protection
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=12
# scrypt work factor. log2(N); 16 => N=65536 (~64 MB per hash at r=8).
AUTH_SCRYPT_LOG_N=15
AUTH_SCRYPT_R=8
AUTH_SCRYPT_P=2

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
# Login is limited far more aggressively than the rest of the API.
RATE_LIMIT_LOGIN_MAX=10
# ANPR gateways post frequently and are limited per device, not per IP.
RATE_LIMIT_ANPR_MAX=600

# --- Background jobs -------------------------------------------------------
# bullmq  -> Redis-backed queue with retries and dead-lettering (default)
# inline  -> run handlers synchronously in-process; used by tests only
QUEUE_DRIVER=bullmq
# Set false on web-facing replicas so only dedicated workers process jobs.
WORKERS_ENABLED=true
# Cron for the nightly charge accrual, in the organisation timezone.
JOB_CHARGE_ACCRUAL_CRON=0 30 0 * * *
JOB_OUTBOX_RELAY_INTERVAL_MS=2000
JOB_NOTIFICATION_RETRY_INTERVAL_MS=30000
JOB_REGISTRY_RETRY_INTERVAL_MS=60000

# --- Object storage --------------------------------------------------------
# s3         -> any S3-compatible endpoint (MinIO locally, S3 in production)
# filesystem -> local directory; convenient for tests, not for production
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_BUCKET=smartpark-dev
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Required for MinIO and for non-AWS S3 implementations.
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY=smartpark
OBJECT_STORAGE_SECRET_KEY=smartpark_dev_only
# Used when OBJECT_STORAGE_DRIVER=filesystem.
OBJECT_STORAGE_LOCAL_PATH=./var/storage
# Lifetime of pre-signed download URLs.
OBJECT_STORAGE_URL_TTL_SECONDS=300
# Upload guards.
UPLOAD_MAX_BYTES=15728640
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# --- ANPR integration ------------------------------------------------------
# mock            -> in-process simulator for local development and tests
# generic-webhook -> real cameras/gateways POST to /api/v1/anpr/events
ANPR_PROVIDER=mock
# Captures below this confidence are queued for human review instead of
# admitting a vehicle automatically. Per-device values override this.
ANPR_CONFIDENCE_THRESHOLD=0.85
# Two captures of the same plate at the same device inside this window are
# treated as one physical event.
ANPR_DEDUPE_WINDOW_SECONDS=120
# Reject capture events whose timestamp is older than this (replay protection).
ANPR_MAX_CLOCK_SKEW_SECONDS=300
# HMAC-SHA256 signature verification on the ingest webhook.
ANPR_REQUIRE_SIGNATURE=false
# Mock provider only: seconds between simulated arrivals. 0 disables.
ANPR_MOCK_INTERVAL_SECONDS=0

# --- Vehicle registry (VAHAN / authorised aggregator) ----------------------
# OPEN ITEM OI-01: the authorised access route is not yet decided. Until it is,
# `mock` is the only implemented provider. See docs/integrations.md.
# mock       -> deterministic simulator, clearly labelled as non-authoritative
# aggregator -> HTTP adapter for a licensed aggregator (credentials required)
VEHICLE_REGISTRY_PROVIDER=mock
VEHICLE_REGISTRY_BASE_URL=
VEHICLE_REGISTRY_API_KEY=
VEHICLE_REGISTRY_TIMEOUT_MS=8000
VEHICLE_REGISTRY_MAX_ATTEMPTS=3
# Circuit breaker: open after N consecutive failures, retry after the cooldown.
VEHICLE_REGISTRY_BREAKER_THRESHOLD=5
VEHICLE_REGISTRY_BREAKER_COOLDOWN_SECONDS=60
# Client-side throttle, requests per minute, to respect an aggregator quota.
VEHICLE_REGISTRY_RATE_LIMIT_PER_MINUTE=60
# How long a successful lookup is considered fresh. Re-enrichment is skipped
# inside this window to control per-call cost (OI-02).
VEHICLE_REGISTRY_CACHE_TTL_HOURS=720

# --- Payment gateway -------------------------------------------------------
# manual -> counter collection recorded by finance staff (Phase 1 default)
# mock   -> simulated gateway with a working webhook, for development
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROVIDER_KEY_ID=
PAYMENT_PROVIDER_KEY_SECRET=
PAYMENT_CALLBACK_BASE_URL=http://localhost:3000

# --- Notifications ---------------------------------------------------------
# mock -> persisted and rendered, not transmitted (development default)
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock
NOTIFICATION_FROM_EMAIL=no-reply@example.invalid
NOTIFICATION_FROM_NAME=Sri JP Smartpark
NOTIFICATION_SMS_SENDER_ID=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
WHATSAPP_BUSINESS_PHONE_ID=
# Global kill switch. When false, notifications are recorded as SUPPRESSED.
NOTIFICATIONS_ENABLED=true

# --- Seeding (development only) -------------------------------------------
# The seed refuses to run when NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@srijpsmartpark.example
SEED_ADMIN_PASSWORD=ChangeMe!Admin2025
SEED_DEFAULT_PASSWORD=ChangeMe!Demo2025
# Volume of demo vehicles/sessions generated.
SEED_VEHICLE_COUNT=60

# --- Web console -----------------------------------------------------------
# Consumed by apps/web. Public (browser-visible) - never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_NAME=SmartPark Enterprise
NEXT_PUBLIC_ORG_NAME=Sri JP Smartpark India Pvt Ltd
